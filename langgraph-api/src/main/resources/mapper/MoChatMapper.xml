<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.moli.common.dao.mapper.MoChatMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.moli.common.dao.entity.MoChat">
        <id column="id" property="id" />
        <result column="app_id" property="appId" />
        <result column="chat_name" property="chatName" />
        <result column="model_name" property="modelName" />
        <result column="create_by" property="createBy" />
        <result column="create_time" property="createTime" />
        <result column="update_by" property="updateBy" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, app_id, chat_name, model_name, create_by, create_time, update_by, update_time
    </sql>

</mapper>
